{
  "name": "civics-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local node_modules/.bin/jest --config jest.config.ts",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/.bin/playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file .env.local seed/index.ts",
    "db:studio": "prisma studio",
    "retention:purge": "tsx --env-file .env.local scripts/retention-purge.ts"
  },
  "dependencies": {
    "@prisma/client": "^5",
    "next": "^14",
    "next-auth": "^4",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "jest": "^29",
    "jest-environment-node": "^29",
    "postcss": "^8",
    "prisma": "^5",
    "tailwindcss": "^3",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "tsx": "^4",
    "typescript": "^5"
  }
}
