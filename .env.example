# =============================================================================
# My Civics Class — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
#
# Values below are LOCAL DEVELOPMENT defaults. Production values live in the
# hosting provider's environment settings, not in this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# Holds curriculum content and the teacher account. It holds nothing about any
# student — see docs/privacy-review.md.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/civics_quest_dev"

# ---------------------------------------------------------------------------
# Google OAuth — TEACHER/ADMIN sign-in only. Students never sign in.
# Obtain credentials from https://console.cloud.google.com
# Production redirect URI: https://mycivicsclass.com/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# REQUIRED. Comma-separated list of the exact Google addresses that may sign in.
# Unset or empty = NOBODY can sign in (fails closed).
#
# This is a list of ADDRESSES, not a domain, on purpose: a district domain is
# shared by every student, and a domain rule would let a student's school
# account reach sign-in.
#   TEACHER_ALLOWED_EMAILS="first.last@palmbeachschools.org"
TEACHER_ALLOWED_EMAILS=""

# ---------------------------------------------------------------------------
# Session + completion codes
# Signs the teacher session cookie AND the completion codes students paste into
# Google Classroom. Changing it signs the teacher out and makes previously
# issued completion codes stop verifying.
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# next-auth (required in development; set explicitly in production)
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET is not used — authOptions.secret reads SESSION_SECRET directly

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
