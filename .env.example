# =============================================================================
# Civics Quest — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/civics_quest_dev"

# ---------------------------------------------------------------------------
# Clever OAuth — primary SSO provider (Phase 2)
# Obtain credentials from https://dev.clever.com
# ---------------------------------------------------------------------------
CLEVER_CLIENT_ID=""
CLEVER_CLIENT_SECRET=""
CLEVER_REDIRECT_URI="http://localhost:3000/api/auth/callback/clever"

# ---------------------------------------------------------------------------
# Google OAuth — fallback auth provider (Phase 2)
# Obtain credentials from https://console.cloud.google.com
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Session
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# next-auth (required in development; set automatically in Vercel/production)
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET is not used — authOptions.secret reads SESSION_SECRET directly

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Feature flags (set to "true" to enable)
# ---------------------------------------------------------------------------
# FEATURE_PARENT_PORTAL — Phase 18 parent login. Keep "false" until the district
# parent-identity-verification policy is confirmed (docs/parent-identity-policy.md).
FEATURE_PARENT_PORTAL="false"
FEATURE_EOC_REVIEW="false"
FEATURE_LEADERBOARDS="false"
FEATURE_AI_DRAFTING="false"
# FEATURE_L1_GLOSSES — first-language glosses on civics terms (Phase 16). Spanish
# translations are owner-approved (ADR 0013); set "true" to show them to students
# whose profile/accommodation resolves an L1 language.
FEATURE_L1_GLOSSES="false"
# FEATURE_SECURE_ASSESSMENT — Focus Mode on secure assessments (ADR 0020):
# fullscreen, blocked copy/paste, and a teacher-visible record of leaving the
# page. Also requires a teacher to turn it on per class. This does NOT lock the
# device — see docs/chromebook-lockdown.md for the GoGuardian / kiosk setup.
FEATURE_SECURE_ASSESSMENT="false"

# ---------------------------------------------------------------------------
# Data retention (Phase 17) — optional, default "retain forever"
# Number of days to keep each data class before it becomes eligible for the
# admin-run purge (npm run retention:purge, or /admin/retention). 0 or unset
# means retain forever. See docs/data-retention.md.
# ---------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS="0"
VOIDED_ATTEMPT_RETENTION_DAYS="0"
# Student activity/session monitoring records (when they were on, for how long).
# Deleting these removes monitoring history only — no student work is affected.
ACTIVITY_SESSION_RETENTION_DAYS="0"

# ---------------------------------------------------------------------------
# Dev-only — NEVER set to "true" in staging or production
# ---------------------------------------------------------------------------
MOCK_AUTH="true"

# ---------------------------------------------------------------------------
# Public demo mode — off by default, set ONLY in a demo deployment
# ---------------------------------------------------------------------------
# Puts the four one-click role buttons (Student/Teacher/Parent/Admin) back on
# the login page even when NODE_ENV=production, so the deployed site can be
# browsed from every perspective with no account. A deliberate, owner-directed
# override of non-negotiable rule #8 — safe ONLY while the database holds
# demo/seed data exclusively, because anyone on the internet then gets ADMIN.
#
# Do NOT set this in .env.local: dev already has open login via MOCK_AUTH, and
# tests/integration/auth.test.ts asserts mockAuthorize() returns null when
# MOCK_AUTH="false" — this flag would override that and fail the test.
#
# To close the site again: delete the variable in Vercel and redeploy. No code
# change needed. See docs/deployment-vercel.md § Public demo mode.
# DEMO_OPEN_LOGIN="true"
