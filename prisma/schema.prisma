// Civics Quest — Full Database Schema
// Phase 1: All tables from spec Section 27, adapted for Prisma.
// Table names use snake_case (@@map). Model fields use camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ApprovalStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  NEEDS_REVISION
  ARCHIVED
}

/// Content trust tier per spec Section 24.2.
/// A = FDOE released (auto-approved), B = reviewed bank,
/// C = AI draft (always Needs Review), D = bulk-approve-by-tag.
enum SourceTier {
  A
  B
  C
  D
}

enum CognitiveComplexity {
  LOW
  MODERATE
  HIGH
}

enum StimulusType {
  NONE
  EXCERPT
  CHART
  MAP
  TABLE
  FLOWCHART
  TIMELINE
  POLITICAL_CARTOON
  DIAGRAM
  SCENARIO
  IMAGE
}

enum ItemType {
  MULTIPLE_CHOICE
  SCENARIO_MC
  SOURCE_MC
  IMAGE_MC
  FLOWCHART_MC
  TIMELINE_MC
  MATCHING
  SEQUENCING
  CATEGORIZATION
  SELECT_ALL
  SHORT_ANSWER
}

enum AssessmentType {
  MASTERY_CHALLENGE
  PRACTICE
  PRE_CHECK
  VOCAB_CHECK
  READINESS_CHECK
  UNIT_REVIEW
  REPUBLIC_CHALLENGE
  FINAL_TRIAL
  REASSESSMENT
  DIAGNOSTIC
}

enum RepublicChallengeMode {
  QUICK_REVIEW
  CATEGORY_CHALLENGE
  MIXED_MISSION
  MISTAKE_REPLAY
  SOURCE_SPRINT
  ENDURANCE_TRIAL
  FINAL_REPUBLIC_TRIAL
}

enum RemediationType {
  VOCABULARY_TRAINING
  MINI_LESSON_REPLAY
  SCENARIO_LAB
  PRIMARY_SOURCE_COACH
  VISUAL_EVIDENCE_LAB
  MISCONCEPTION_FIX
  BASIC_RETEACH
  GUIDED_REASONING
}

enum StudentActivityType {
  MISSION_TRAINING
  ASSESSMENT
  DAILY_DRILL
  STRATEGY_TRACK
  SOURCE_DECODER
  REMEDIATION
}

/// Student benchmark progress statuses per spec Section 12.2.
enum StudentProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_MASTERY
  NEEDS_REMEDIATION
  REMEDIATION_COMPLETE
  MASTERED
  EXPOSURE_COMPLETE
  TEACHER_OVERRIDE
  INTERVENTION_REQUIRED
}

enum TermTier {
  TIER_2
  TIER_3
}

enum BenchmarkConnectionType {
  PREREQUISITE
  CO_REQUISITE
  EXTENDS
  SUPPORTS
}

enum LessonStepType {
  VIDEO
  NOTE
  INTERACTIVE_CHECK
  DISCUSSION
  WORKED_EXAMPLE
  VOCABULARY
  SOURCE_ANALYSIS
  IMAGE
  DIAGRAM
  INFOGRAPHIC
}

// Did this LessonStep's row come from the static seed defs, or was it
// added in-app by an admin via the lesson content editor? Lets the seeder
// know a lesson's step LIST has diverged from its LessonSeedDef (see
// Lesson.structureEditedAt) without needing to diff the two.
enum LessonStepSource {
  SEED
  ADMIN
}

enum ResourceType {
  VIDEO
  ARTICLE
  PRIMARY_SOURCE
  INTERACTIVE
  WORKSHEET
  REFERENCE
}

enum AssignmentStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RemediationStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum BadgeTrack {
  MASTERY
  READING
  STRATEGY
  ENGAGEMENT
}

enum TeacherOverrideAction {
  UNLOCK_BENCHMARK
  MARK_MASTERED
  MARK_EXPOSURE_COMPLETE
  ASSIGN_REMEDIATION
  EXTEND_DEADLINE
  CUSTOM
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  DROPPED
}

/// Where a suggestion is routed for review. Derived from the author's role at
/// submit time and then STORED — never recomputed from User.role at read time,
/// so a role change can't silently relocate old suggestions.
enum SuggestionAudience {
  TEACHER
  ADMIN
}

enum SuggestionStatus {
  NEW
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// What the author meant this to be. Chosen in the box via a toggle; drives which
/// tab it lands on in the teacher report page. Defaults to COMMENT so the column is
/// additive over rows written before the toggle existed.
enum SuggestionKind {
  COMMENT
  QUESTION
}

enum ParentVerifiedStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ============================================================
// USERS, STUDENTS, TEACHERS, PARENTS
// ============================================================

model User {
  id        String     @id @default(cuid())
  role      UserRole
  cleverId  String?    @unique @map("clever_id")
  googleId  String?    @unique @map("google_id")
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  email     String?    @unique
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  student   Student?
  teacher   Teacher?
  parent    Parent?
  auditLogs AuditLog[]

  suggestionsAuthored Suggestion[] @relation("SuggestionAuthor")
  suggestionsReviewed Suggestion[] @relation("SuggestionReviewer")

  @@map("users")
}

model Student {
  id                String  @id @default(cuid())
  userId            String  @unique @map("user_id")
  districtStudentId String? @unique @map("district_student_id")
  gradeLevel        Int     @default(7) @map("grade_level")
  active            Boolean @default(true)
  l1Language        String? @map("l1_language")
  ellStatus         String? @map("ell_status")
  readingLevelFlag  Boolean @default(false) @map("reading_level_flag")
  eseStatus         Boolean @default(false) @map("ese_status")

  user                  User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinks           ParentStudentLink[]
  classEnrollments      ClassEnrollment[]
  studentProgress       StudentProgress[]
  assessmentAttempts    AssessmentAttempt[]
  studentRemediations   StudentRemediation[]
  spacedReviewStates    SpacedReviewState[]
  spacedReviewEvents    SpacedReviewEvent[]
  confidenceSnapshots   ConfidenceCalibrationSnapshot[]
  sourceDecoderProgress SourceDecoderProgress[]
  strategyTrackProgress StrategyTrackProgress[]
  strategyOverrides     StudentStrategyOverride[]
  studentBadges         StudentBadge[]
  eocReadiness          EocReadinessSnapshot[]
  eocActualScores       EocActualScore[]
  accommodations        StudentAccommodation[]
  teacherOverrides      TeacherOverride[]
  streakState           StreakState?
  narrativeProgress     NarrativeProgress[]
  uiSettings            StudentUiSettings?
  activitySessions      StudentActivitySession[]
  lastActivity          StudentLastActivity?
  suggestions           Suggestion[]

  @@map("students")
}

model Teacher {
  id       String  @id @default(cuid())
  userId   String  @unique @map("user_id")
  schoolId String? @map("school_id")
  active   Boolean @default(true)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes     Class[]
  overrides   TeacherOverride[]
  suggestions Suggestion[]

  @@map("teachers")
}

model Parent {
  id     String  @id @default(cuid())
  userId String  @unique @map("user_id")
  active Boolean @default(true)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks ParentStudentLink[]

  @@map("parents")
}

model ParentStudentLink {
  id             String               @id @default(cuid())
  parentId       String               @map("parent_id")
  studentId      String               @map("student_id")
  relationship   String
  verifiedStatus ParentVerifiedStatus @default(PENDING) @map("verified_status")
  createdAt      DateTime             @default(now()) @map("created_at")

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@map("parent_student_links")
}

// ============================================================
// CLASSES & ENROLLMENTS
// ============================================================

model Class {
  id           String  @id @default(cuid())
  teacherId    String  @map("teacher_id")
  name         String
  period       String?
  schoolYear   String  @map("school_year")
  active       Boolean @default(true)
  subPrepNotes String? @db.Text @map("sub_prep_notes")

  // Phase 11 — Republic Challenge per-class configuration
  rcSessionLengthOverride Int?    @map("rc_session_length_override")
  rcAttemptsAllowed       Int     @default(1) @map("rc_attempts_allowed")
  rcReviewWindow          String  @default("after_submit") @map("rc_review_window")
  rcStaminaOverride       Int?    @map("rc_stamina_override")
  featureEocReviewEnabled Boolean @default(true) @map("feature_eoc_review_enabled")

  // Strategy Track — global required number of correct apply-it "uses" per
  // strategy mission (0 = no requirement). Per-student overrides live on
  // StudentStrategyOverride.
  strategyUsesRequired Int @default(0) @map("strategy_uses_required")

  // Assessment integrity — when true, secure assessments run in Focus Mode
  // (fullscreen, blocked copy/paste, focus-loss events recorded for the
  // teacher). Off by default; also requires FEATURE_SECURE_ASSESSMENT.
  // See docs/adrs/0020-assessment-integrity-and-device-lockdown.md.
  secureAssessmentMode Boolean @default(false) @map("secure_assessment_mode")

  teacher            Teacher                     @relation(fields: [teacherId], references: [id])
  enrollments        ClassEnrollment[]
  assignments        Assignment[]
  readinessSnapshots ClassReadinessSnapshot[]
  stepVisibility     ClassLessonStepVisibility[]
  suggestions        Suggestion[]

  @@map("classes")
}

model ClassEnrollment {
  id         String           @id @default(cuid())
  classId    String           @map("class_id")
  studentId  String           @map("student_id")
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@map("class_enrollments")
}

// ============================================================
// CURRICULUM: UNITS, REPORTING CATEGORIES, BENCHMARKS
// ============================================================

model Unit {
  id                   String  @id @default(cuid())
  title                String
  description          String?
  sequenceOrder        Int     @map("sequence_order")
  gameRegionName       String  @map("game_region_name")
  reportingCategoryMix Json?   @map("reporting_category_mix")
  active               Boolean @default(true)

  benchmarks        Benchmark[]
  narrativeProgress NarrativeProgress[]

  @@map("units")
}

model ReportingCategory {
  id                 String  @id @default(cuid())
  name               String  @unique
  blueprintWeightMin Float   @map("blueprint_weight_min")
  blueprintWeightMax Float   @map("blueprint_weight_max")
  description        String?

  benchmarks              Benchmark[]
  questions               Question[]
  misconceptions          Misconception[]
  eocReadinessSnapshots   EocReadinessSnapshot[]
  classReadinessSnapshots ClassReadinessSnapshot[]

  @@map("reporting_categories")
}

model Benchmark {
  id                  String         @id @default(cuid())
  code                String         @unique
  title               String
  unitId              String         @map("unit_id")
  reportingCategoryId String         @map("reporting_category_id")
  sequenceOrder       Int            @map("sequence_order")
  lessonSummary       String?        @map("lesson_summary")
  officialStatement   String?        @map("official_statement")
  approvalStatus      ApprovalStatus @default(DRAFT) @map("approval_status")
  version             Int            @default(1)

  unit                 Unit                   @relation(fields: [unitId], references: [id])
  reportingCategory    ReportingCategory      @relation(fields: [reportingCategoryId], references: [id])
  clarifications       BenchmarkClarification[]
  connectionsFrom      BenchmarkConnection[]  @relation("ConnectionSource")
  connectionsTo        BenchmarkConnection[]  @relation("ConnectionTarget")
  terms                Term[]
  resources            Resource[]
  lessons              Lesson[]
  questions            Question[]
  assessments          Assessment[]
  assignments          Assignment[]
  studentProgress      StudentProgress[]
  remediationItems     RemediationItem[]
  spacedReviewStates   SpacedReviewState[]
  spacedReviewEvents   SpacedReviewEvent[]

  @@map("benchmarks")
}

model BenchmarkClarification {
  id            String @id @default(cuid())
  benchmarkId   String @map("benchmark_id")
  text          String
  sequenceOrder Int    @map("sequence_order")

  benchmark Benchmark @relation(fields: [benchmarkId], references: [id])

  @@map("benchmark_clarifications")
}

model BenchmarkConnection {
  id                   String                  @id @default(cuid())
  benchmarkId          String                  @map("benchmark_id")
  connectedBenchmarkId String                  @map("connected_benchmark_id")
  relationshipType     BenchmarkConnectionType @map("relationship_type")

  benchmark          Benchmark @relation("ConnectionSource", fields: [benchmarkId], references: [id])
  connectedBenchmark Benchmark @relation("ConnectionTarget", fields: [connectedBenchmarkId], references: [id])

  @@unique([benchmarkId, connectedBenchmarkId])
  @@map("benchmark_connections")
}

// ============================================================
// VOCABULARY
// ============================================================

model Term {
  id             String         @id @default(cuid())
  benchmarkId    String?        @map("benchmark_id")
  term           String
  definition     String
  tier           TermTier
  relatedVocab   String?        @map("related_vocab")
  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")

  benchmark    Benchmark?        @relation(fields: [benchmarkId], references: [id])
  translations TermTranslation[]

  @@map("terms")
}

model TermTranslation {
  id                   String         @id @default(cuid())
  termId               String         @map("term_id")
  languageCode         String         @map("language_code")
  definitionTranslated String         @map("definition_translated")
  approvalStatus       ApprovalStatus @default(DRAFT) @map("approval_status")

  term Term @relation(fields: [termId], references: [id])

  @@unique([termId, languageCode])
  @@map("term_translations")
}

// ============================================================
// RESOURCES & LESSONS
// ============================================================

model Resource {
  id             String         @id @default(cuid())
  benchmarkId    String         @map("benchmark_id")
  title          String
  url            String?
  resourceType   ResourceType   @map("resource_type")
  description    String?
  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")

  benchmark Benchmark @relation(fields: [benchmarkId], references: [id])

  @@map("resources")
}

model Lesson {
  id                    String         @id @default(cuid())
  benchmarkId           String         @map("benchmark_id")
  title                 String
  body                  String
  studentFriendlyTarget String         @map("student_friendly_target")
  approvalStatus        ApprovalStatus @default(DRAFT) @map("approval_status")
  version               Int            @default(1)
  // Set the moment an admin adds/removes/reorders this lesson's steps via the
  // content editor. Once set, the seeder never touches this lesson's step
  // list again on any future `db:seed` run (see seed/lessons/_seeder.ts) —
  // admin-added steps can't be mistaken for "dropped" and deleted, and a
  // deliberately-removed step can't be resurrected by its old seed def.
  structureEditedAt DateTime? @map("structure_edited_at")

  benchmark Benchmark   @relation(fields: [benchmarkId], references: [id])
  steps     LessonStep[]

  @@map("lessons")
}

model LessonStep {
  id            String         @id @default(cuid())
  lessonId      String         @map("lesson_id")
  stepType      LessonStepType @map("step_type")
  title         String
  content       String
  sequenceOrder Int            @map("sequence_order")
  required      Boolean        @default(true)
  // Global teacher kill-switch for media steps (per-class overrides live on
  // ClassLessonStepVisibility). Core instructional steps stay enabled.
  enabled       Boolean        @default(true)
  // Set the moment an admin edits this step's global content via the content
  // editor. Once set, a reseed excludes title/content/stepType from this
  // step's update payload (title/content stay whatever the admin set) —
  // mirrors how `enabled` is already permanently excluded from reseed today.
  contentEditedAt DateTime?        @map("content_edited_at")
  source          LessonStepSource @default(SEED) @map("source")

  lesson          Lesson                      @relation(fields: [lessonId], references: [id])
  currentProgress StudentProgress[]           @relation("CurrentLessonStep")
  classVisibility ClassLessonStepVisibility[]

  @@map("lesson_steps")
}

// Per-class override for a lesson step, on two independent axes:
//   - visibility: null = inherit the step's global `enabled` flag;
//     true/false forces show/hide (existing ADR 0015 behavior, unchanged).
//   - content: overrideTitle/overrideContent null = inherit the step's
//     global title/content; non-null = this class sees the override instead
//     (ADR TBD — lesson content editor). The two axes are independent: a
//     step can be globally enabled but hidden for class A while also
//     carrying a content override that only matters for class B.
// A row with all three overrides null is meaningless and is pruned (see
// pruneOrUpdateOverrideRow in src/lib/lesson-media/index.ts). Cascade: an
// override is meaningless once its step is deleted.
model ClassLessonStepVisibility {
  id              String   @id @default(cuid())
  classId         String   @map("class_id")
  lessonStepId    String   @map("lesson_step_id")
  visible         Boolean?
  overrideTitle   String?  @map("override_title")
  overrideContent String?  @map("override_content")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  class      Class      @relation(fields: [classId], references: [id])
  lessonStep LessonStep @relation(fields: [lessonStepId], references: [id], onDelete: Cascade)

  @@unique([classId, lessonStepId])
  @@map("class_lesson_step_visibility")
}

// Binary storage for teacher/admin-uploaded lesson images (Postgres, not
// local disk — this app is documented as stateless/horizontally-scalable
// behind a load balancer; a filesystem write would only be visible from
// whichever instance received the upload). Served by
// src/app/media/uploads/[id]/route.ts at the public path
// `/media/uploads/<id>` — a cuid is lowercase alphanumeric, so it already
// matches ImageSchema.asset's `/media/...` pattern with no schema changes.
// Rows are immutable once created (content-addressed by id) — safe to cache
// the served response forever.
model UploadedLessonImage {
  id         String   @id @default(cuid())
  mimeType   String   @map("mime_type")
  byteSize   Int      @map("byte_size")
  // Nullable: the hand-rolled dimension parser (src/lib/media-upload/format.ts)
  // is best-effort for some formats (e.g. lossless WebP) and returns null on
  // a parse miss rather than failing the upload — the uploader just types
  // width/height in manually on the subsequent content-edit call.
  width      Int?
  height     Int?
  data       Bytes
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("uploaded_lesson_images")
}

// ============================================================
// STIMULI
// ============================================================

model Stimulus {
  id               String         @id @default(cuid())
  title            String
  stimulusType     StimulusType   @map("stimulus_type")
  content          String
  mediaUrl         String?        @map("media_url")
  source           String?
  copyrightNotes   String?        @map("copyright_notes")
  readingLoadLevel Int            @map("reading_load_level")
  approvalStatus   ApprovalStatus @default(DRAFT) @map("approval_status")

  variants  StimulusVariant[]
  questions Question[]

  @@map("stimuli")
}

model StimulusVariant {
  id               String         @id @default(cuid())
  stimulusId       String         @map("stimulus_id")
  readingLoadLevel Int            @map("reading_load_level")
  content          String
  approvalStatus   ApprovalStatus @default(DRAFT) @map("approval_status")

  stimulus Stimulus @relation(fields: [stimulusId], references: [id])

  @@unique([stimulusId, readingLoadLevel])
  @@map("stimulus_variants")
}

// ============================================================
// QUESTIONS & OPTIONS
// ============================================================

model Question {
  id                  String              @id @default(cuid())
  /// Stable external key for idempotent seed imports. Format: q-{benchmarkCode}-{NNN}
  externalKey         String?             @unique @map("external_key")
  benchmarkId         String              @map("benchmark_id")
  reportingCategoryId String              @map("reporting_category_id")
  prompt              String
  stimulusId          String?             @map("stimulus_id")
  itemType            ItemType            @map("item_type")
  difficulty          Float               @default(0.5)
  cognitiveComplexity CognitiveComplexity @map("cognitive_complexity")
  readingLoadLevel    Int                 @map("reading_load_level")
  skillTag            String              @map("skill_tag")
  remediationTag      String              @map("remediation_tag")
  misconceptionId     String?             @map("misconception_id")
  approvalStatus      ApprovalStatus      @default(APPROVED) @map("approval_status")
  sourceTier          SourceTier          @default(B) @map("source_tier")
  active              Boolean             @default(true)

  benchmark         Benchmark         @relation(fields: [benchmarkId], references: [id])
  reportingCategory ReportingCategory @relation(fields: [reportingCategoryId], references: [id])
  stimulus          Stimulus?         @relation(fields: [stimulusId], references: [id])
  misconception     Misconception?    @relation("QuestionMisconception", fields: [misconceptionId], references: [id])
  options           QuestionOption[]
  assessmentItems   AssessmentQuestion[]
  attemptResponses  AttemptResponse[]
  spacedReviewEvents SpacedReviewEvent[]

  @@index([benchmarkId])
  @@map("questions")
}

model QuestionOption {
  id              String  @id @default(cuid())
  questionId      String  @map("question_id")
  optionText      String  @map("option_text")
  /// SECURITY: Never expose isCorrect to the client before submission of a secure assessment.
  isCorrect       Boolean @map("is_correct")
  feedback        String?
  misconceptionId String? @map("misconception_id")

  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  misconception    Misconception? @relation("OptionMisconception", fields: [misconceptionId], references: [id])
  attemptResponses AttemptResponse[]

  @@map("question_options")
}

// ============================================================
// MISCONCEPTIONS
// ============================================================

model Misconception {
  id                      String         @id @default(cuid())
  code                    String         @unique
  reportingCategoryId     String         @map("reporting_category_id")
  label                   String
  description             String
  commonDistractorPattern String?        @map("common_distractor_pattern")
  /// Optional: points to a RemediationItem specifically designed to fix this misconception.
  fixRemediationId        String?        @map("fix_remediation_id")
  approvalStatus          ApprovalStatus @default(APPROVED) @map("approval_status")

  reportingCategory ReportingCategory @relation(fields: [reportingCategoryId], references: [id])
  fixRemediation    RemediationItem?  @relation("MisconceptionFix", fields: [fixRemediationId], references: [id])
  questions         Question[]        @relation("QuestionMisconception")
  questionOptions   QuestionOption[]  @relation("OptionMisconception")
  remediationItems  RemediationItem[] @relation("RemediationMisconception")

  @@map("misconceptions")
}

// ============================================================
// ASSESSMENTS
// ============================================================

model Assessment {
  id               String                 @id @default(cuid())
  /// Nullable for Republic Challenge / Final Trial assessments which span benchmarks (Phase 11).
  /// All other AssessmentTypes require benchmarkId — enforced in code.
  benchmarkId      String?                @map("benchmark_id")
  title            String
  assessmentType   AssessmentType         @map("assessment_type")
  /// Set only when assessmentType is REPUBLIC_CHALLENGE or FINAL_TRIAL.
  mode             RepublicChallengeMode? @map("mode")
  masteryThreshold Float                  @default(0.80) @map("mastery_threshold")
  blueprintJson    Json?                  @map("blueprint_json")
  approvalStatus   ApprovalStatus         @default(DRAFT) @map("approval_status")

  benchmark   Benchmark?           @relation(fields: [benchmarkId], references: [id])
  questions   AssessmentQuestion[]
  attempts    AssessmentAttempt[]
  assignments Assignment[]

  @@map("assessments")
}

model AssessmentQuestion {
  id            String @id @default(cuid())
  assessmentId  String @map("assessment_id")
  questionId    String @map("question_id")
  sequenceOrder Int    @map("sequence_order")
  points        Float  @default(1.0)

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  question   Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

// ============================================================
// ASSIGNMENTS
// ============================================================

model Assignment {
  id           String           @id @default(cuid())
  classId      String           @map("class_id")
  benchmarkId  String           @map("benchmark_id")
  assessmentId String?          @map("assessment_id")
  assignedBy   String           @map("assigned_by")
  startAt      DateTime?        @map("start_at")
  dueAt        DateTime?        @map("due_at")
  status       AssignmentStatus @default(SCHEDULED)

  class      Class       @relation(fields: [classId], references: [id])
  benchmark  Benchmark   @relation(fields: [benchmarkId], references: [id])
  assessment Assessment? @relation(fields: [assessmentId], references: [id])

  @@map("assignments")
}

