// ============================================================
// STUDENT ACTIVITY SESSIONS
// Answers "when was this student on the platform, for how long, and what did
// they get done" — see docs/adrs/0019-student-activity-sessions.md.
//
// Sessions are ACTIVITY-driven, not auth-driven: the auth layer uses JWT
// sessions with no DB adapter, so `events.signIn` only fires on a genuine
// sign-in (a student returning with a valid cookie fires nothing). The first
// activity after a gap of SESSION_GAP_MINUTES opens a new session instead.
//
// `activeSeconds` accumulates BOUNDED deltas (see sessionize.activeDelta) so a
// backgrounded or abandoned tab cannot inflate it; the wall-clock span is
// always derivable as lastActiveAt - startedAt.
//
// Progress is attributed to a session by TIME WINDOW against the existing
// tables (attempts, review events, mastery) — no session id is stamped onto
// student work rows.
// ============================================================

model StudentActivitySession {
  id            String    @id @default(cuid())
  studentId     String    @map("student_id")
  startedAt     DateTime  @default(now()) @map("started_at")
  lastActiveAt  DateTime  @default(now()) @map("last_active_at")
  /// Set when the session is idle-closed or superseded. Null = still open.
  endedAt       DateTime? @map("ended_at")
  /// Engaged time in seconds — sum of bounded per-touch deltas, never span.
  activeSeconds Int       @default(0) @map("active_seconds")
  /// Bucketed area → seconds, e.g. { "mission": 1320, "drill": 480 }.
  /// Area is a validated enum at the API boundary; raw paths are never stored.
  areaSeconds   Json?     @map("area_seconds")
  /// Where the student was on their MOST RECENT touch — what the live panel
  /// shows. Distinct from areaSeconds, which is where time has accumulated:
  /// a student who spent 30m on missions then opened the drill is "on" the
  /// drill, and a student who just arrived has a current area but no tallies.
  lastArea      String?   @map("last_area")
  /// True when this session was opened by a real sign-in (vs. resumed work).
  startedByLogin Boolean  @default(false) @map("started_by_login")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, startedAt])
  @@index([lastActiveAt])
  @@map("student_activity_sessions")
}

model StudentUiSettings {
  id                String  @id @default(cuid())
  studentId         String  @unique @map("student_id")
  pausePointMinutes Int     @default(40) @map("pause_point_minutes")
  reduceMotion      Boolean @default(false) @map("reduce_motion")
  highContrast      Boolean @default(false) @map("high_contrast")
  largeText         Boolean @default(false) @map("large_text")
  skipAllNpcs       Boolean @default(false) @map("skip_all_npcs")

  student Student @relation(fields: [studentId], references: [id])

  @@map("student_ui_settings")
}
// SUGGESTION BOX (ADR 0021)
// ============================================================

/// A free-text suggestion filed from the nav-bar suggestion box, carrying a
/// snapshot of which page the author was on. Students' suggestions route to
/// their teacher; teachers' and admins' route to the site admin.
model Suggestion {
  id       String             @id @default(cuid())
  audience SuggestionAudience
  status   SuggestionStatus   @default(NEW)
  /// Comment vs. question, chosen by the author. Routes to separate tabs on the
  /// teacher report page.
  kind     SuggestionKind     @default(COMMENT)

  authorUserId String @map("author_user_id")
  /// Role snapshot at submit time. `audience` is derived from THIS at creation,
  /// never from User.role at read time.
  authorRole   UserRole @map("author_role")
  /// Set when a student filed it. Powers the roster-union read that surfaces
  /// suggestions filed before the student was enrolled anywhere.
  authorStudentId String? @map("author_student_id")

  /// "The teacher in the loop" — NOT a pure recipient FK. For a student-authored
  /// suggestion this is the recipient teacher, resolved at submit time from the
  /// student's earliest active enrollment. For a teacher-authored one it is the
  /// author themselves. Null when a student had no active enrollment at submit
  /// time (the roster-union read recovers those once they enroll).
  teacherId String? @map("teacher_id")
  /// The class that resolved `teacherId`. Null for teacher/admin authors and for
  /// unenrolled students.
  classId   String? @map("class_id")

  /// Plain text, exactly as typed. Never parsed, never rendered as HTML — read
  /// surfaces render it as text inside `whitespace-pre-wrap`.
  body String @db.Text
  /// The concrete pathname the author was on, e.g. /student/mission/SS.7.CG.1.1.
  pathname String
  /// Server-derived parameterized route, e.g. /student/mission/[benchmarkCode].
  /// The groupable, PII-free dimension — safe to put in a query string.
  routePattern String @map("route_pattern")
  /// Server-derived human label for `routePattern`, e.g. "Mission page".
  pageLabel    String @map("page_label")
  /// Non-identifying triage context only: { viewportWidth, params }.
  /// Deliberately NO user-agent and NO IP — rule #9 (these are minors).
  contextJson Json? @map("context_json")

  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")
  /// Private note from the reviewer. Never shown to the author.
  reviewerNote     String?   @db.Text @map("reviewer_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authorUser    User     @relation("SuggestionAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  reviewedBy    User?    @relation("SuggestionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  authorStudent Student? @relation(fields: [authorStudentId], references: [id])
  teacher       Teacher? @relation(fields: [teacherId], references: [id])
  class         Class?   @relation(fields: [classId], references: [id])

  @@index([audience, status, createdAt])
  @@index([teacherId, status, createdAt])
  @@index([authorStudentId, createdAt])
  @@index([routePattern])
  // The queues are always read kind-filtered (comments tab vs questions tab), and
  // the teacher read is an OR across two branches, which no single index covers
  // cleanly — this carries the kind for the audience-scoped admin path.
  @@index([audience, kind, status, createdAt])
  @@map("suggestions")
}
