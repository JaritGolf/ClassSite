// My Civics Class — Database Schema
//
// This database holds CURRICULUM CONTENT and the TEACHER ACCOUNT. It holds
// nothing about any student: no student rows, no pseudonymous or coded rows,
// no attempts, no progress, no accommodations, no activity. Student progress
// lives only in the student's own browser (src/lib/local-progress).
//
// tests/unit/guards/no-student-data.test.ts fails if a student-linked model or
// field is added here. Table names use snake_case (@@map); fields camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Only staff have accounts. Students never sign in and have no row anywhere.
enum UserRole {
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ApprovalStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  NEEDS_REVISION
  ARCHIVED
}

/// Content trust tier per spec Section 24.2.
/// A = FDOE released (auto-approved), B = reviewed bank,
/// C = AI draft (always Needs Review), D = bulk-approve-by-tag.
enum SourceTier {
  A
  B
  C
  D
}

enum CognitiveComplexity {
  LOW
  MODERATE
  HIGH
}

enum StimulusType {
  NONE
  EXCERPT
  CHART
  MAP
  TABLE
  FLOWCHART
  TIMELINE
  POLITICAL_CARTOON
  DIAGRAM
  SCENARIO
  IMAGE
}

enum ItemType {
  MULTIPLE_CHOICE
  SCENARIO_MC
  SOURCE_MC
  IMAGE_MC
  FLOWCHART_MC
  TIMELINE_MC
  MATCHING
  SEQUENCING
  CATEGORIZATION
  SELECT_ALL
  SHORT_ANSWER
}

enum AssessmentType {
  MASTERY_CHALLENGE
  PRACTICE
  PRE_CHECK
  VOCAB_CHECK
  READINESS_CHECK
  UNIT_REVIEW
  REPUBLIC_CHALLENGE
  FINAL_TRIAL
  REASSESSMENT
  DIAGNOSTIC
}

enum RemediationType {
  VOCABULARY_TRAINING
  MINI_LESSON_REPLAY
  SCENARIO_LAB
  PRIMARY_SOURCE_COACH
  VISUAL_EVIDENCE_LAB
  MISCONCEPTION_FIX
  BASIC_RETEACH
  GUIDED_REASONING
}

enum TermTier {
  TIER_2
  TIER_3
}

enum BenchmarkConnectionType {
  PREREQUISITE
  CO_REQUISITE
  EXTENDS
  SUPPORTS
}

enum LessonStepType {
  VIDEO
  NOTE
  INTERACTIVE_CHECK
  DISCUSSION
  WORKED_EXAMPLE
  VOCABULARY
  SOURCE_ANALYSIS
  IMAGE
  DIAGRAM
  INFOGRAPHIC
}

// Did this LessonStep's row come from the static seed defs, or was it
// added in-app by an admin via the lesson content editor? Lets the seeder
// know a lesson's step LIST has diverged from its LessonSeedDef (see
// Lesson.structureEditedAt) without needing to diff the two.
enum LessonStepSource {
  SEED
  ADMIN
}

enum ResourceType {
  VIDEO
  ARTICLE
  PRIMARY_SOURCE
  INTERACTIVE
  WORKSHEET
  REFERENCE
}

enum BadgeTrack {
  MASTERY
  READING
  STRATEGY
  ENGAGEMENT
}

// ============================================================
// STAFF ACCOUNTS (teacher / admin only — students have no accounts)
// ============================================================

model User {
  id        String     @id @default(cuid())
  role      UserRole
  googleId  String?    @unique @map("google_id")
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  email     String?    @unique
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  teacher   Teacher?
  auditLogs AuditLog[]

  @@map("users")
}

model Teacher {
  id       String  @id @default(cuid())
  userId   String  @unique @map("user_id")
  schoolId String? @map("school_id")
  active   Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes Class[]

  @@map("teachers")
}

// ============================================================
// CLASSES (a label for a lesson arrangement; classes have no roster)
// ============================================================

model Class {
  id           String  @id @default(cuid())
  teacherId    String  @map("teacher_id")
  name         String
  period       String?
  schoolYear   String  @map("school_year")
  active       Boolean @default(true)
  subPrepNotes String? @map("sub_prep_notes") @db.Text

  // Phase 11 — Republic Challenge per-class configuration
  rcSessionLengthOverride Int?    @map("rc_session_length_override")
  rcStaminaOverride       Int?    @map("rc_stamina_override")
  featureEocReviewEnabled Boolean @default(true) @map("feature_eoc_review_enabled")

  // Strategy Track — global required number of correct apply-it "uses" per
  // strategy mission (0 = no requirement). The same soft target is shown to
  // everyone; uses are counted on each student's own device.
  strategyUsesRequired Int @default(0) @map("strategy_uses_required")

  teacher          Teacher                     @relation(fields: [teacherId], references: [id])
  stepVisibility   ClassLessonStepVisibility[]
  classLessonSteps ClassLessonStep[]
  lessonOutlines   ClassLessonOutline[]

  @@map("classes")
}

// ============================================================
// CURRICULUM: UNITS, REPORTING CATEGORIES, BENCHMARKS
// ============================================================

model Unit {
  id                   String  @id @default(cuid())
  title                String
  description          String?
  sequenceOrder        Int     @map("sequence_order")
  gameRegionName       String  @map("game_region_name")
  reportingCategoryMix Json?   @map("reporting_category_mix")
  active               Boolean @default(true)

  benchmarks Benchmark[]

  @@map("units")
}

model ReportingCategory {
  id                 String  @id @default(cuid())
  name               String  @unique
  blueprintWeightMin Float   @map("blueprint_weight_min")
  blueprintWeightMax Float   @map("blueprint_weight_max")
  description        String?

  benchmarks     Benchmark[]
  questions      Question[]
  misconceptions Misconception[]

  @@map("reporting_categories")
}

model Benchmark {
  id                  String         @id @default(cuid())
  code                String         @unique
  title               String
  unitId              String         @map("unit_id")
  reportingCategoryId String         @map("reporting_category_id")
  sequenceOrder       Int            @map("sequence_order")
  lessonSummary       String?        @map("lesson_summary")
  officialStatement   String?        @map("official_statement")
  approvalStatus      ApprovalStatus @default(DRAFT) @map("approval_status")
  version             Int            @default(1)

  /// Teacher-controlled gate on whether students may open this mission.
  /// ANDed with the content check (approved mastery form with questions +
  /// approved lesson) — it is an ADDITIONAL gate, never a replacement.
  /// Defaults false: content is seeded piecemeal by design, so the existence of
  /// some rows is not evidence a mission is ready for a 12-year-old.
  /// See src/lib/mastery/availability.ts.
  readyForStudents Boolean @default(false) @map("ready_for_students")

  unit              Unit                     @relation(fields: [unitId], references: [id])
  reportingCategory ReportingCategory        @relation(fields: [reportingCategoryId], references: [id])
  clarifications    BenchmarkClarification[]
  connectionsFrom   BenchmarkConnection[]    @relation("ConnectionSource")
  connectionsTo     BenchmarkConnection[]    @relation("ConnectionTarget")
  terms             Term[]
  resources         Resource[]
  lessons           Lesson[]
  questions         Question[]
  assessments       Assessment[]
  remediationItems  RemediationItem[]

  @@map("benchmarks")
}

model BenchmarkClarification {
  id            String @id @default(cuid())
  benchmarkId   String @map("benchmark_id")
  text          String
  sequenceOrder Int    @map("sequence_order")

  benchmark Benchmark @relation(fields: [benchmarkId], references: [id])

  @@map("benchmark_clarifications")
}

model BenchmarkConnection {
  id                   String                  @id @default(cuid())
  benchmarkId          String                  @map("benchmark_id")
  connectedBenchmarkId String                  @map("connected_benchmark_id")
  relationshipType     BenchmarkConnectionType @map("relationship_type")

  benchmark          Benchmark @relation("ConnectionSource", fields: [benchmarkId], references: [id])
  connectedBenchmark Benchmark @relation("ConnectionTarget", fields: [connectedBenchmarkId], references: [id])

  @@unique([benchmarkId, connectedBenchmarkId])
  @@map("benchmark_connections")
}

// ============================================================
// VOCABULARY
// ============================================================

model Term {
  id             String         @id @default(cuid())
  benchmarkId    String?        @map("benchmark_id")
  term           String
  definition     String
  tier           TermTier
  relatedVocab   String?        @map("related_vocab")
  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")

  benchmark    Benchmark?        @relation(fields: [benchmarkId], references: [id])
  translations TermTranslation[]

  @@map("terms")
}

model TermTranslation {
  id                   String         @id @default(cuid())
  termId               String         @map("term_id")
  languageCode         String         @map("language_code")
  definitionTranslated String         @map("definition_translated")
  approvalStatus       ApprovalStatus @default(DRAFT) @map("approval_status")

  term Term @relation(fields: [termId], references: [id])

  @@unique([termId, languageCode])
  @@map("term_translations")
}

// ============================================================
// RESOURCES & LESSONS
// ============================================================

model Resource {
  id             String         @id @default(cuid())
  benchmarkId    String         @map("benchmark_id")
  title          String
  url            String?
  resourceType   ResourceType   @map("resource_type")
  description    String?
  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")

  benchmark Benchmark @relation(fields: [benchmarkId], references: [id])

  @@map("resources")
}

model Lesson {
  id                    String         @id @default(cuid())
  benchmarkId           String         @map("benchmark_id")
  title                 String
  body                  String
  studentFriendlyTarget String         @map("student_friendly_target")
  approvalStatus        ApprovalStatus @default(DRAFT) @map("approval_status")
  version               Int            @default(1)
  // Set the moment an admin adds/removes/reorders this lesson's steps via the
  // content editor. Once set, the seeder never touches this lesson's step
  // list again on any future `db:seed` run (see seed/lessons/_seeder.ts) —
  // admin-added steps can't be mistaken for "dropped" and deleted, and a
  // deliberately-removed step can't be resurrected by its old seed def.
  structureEditedAt     DateTime?      @map("structure_edited_at")

  benchmark     Benchmark            @relation(fields: [benchmarkId], references: [id])
  steps         LessonStep[]
  // Per-class authoring layer (ADR 0023). Both cascade — a teacher's modules
  // and their arrangement are meaningless once the lesson itself is gone.
  classSteps    ClassLessonStep[]
  classOutlines ClassLessonOutline[]

  @@map("lessons")
}

model LessonStep {
  id              String           @id @default(cuid())
  lessonId        String           @map("lesson_id")
  stepType        LessonStepType   @map("step_type")
  title           String
  content         String
  sequenceOrder   Int              @map("sequence_order")
  required        Boolean          @default(true)
  // Global teacher kill-switch for media steps (per-class overrides live on
  // ClassLessonStepVisibility). Core instructional steps stay enabled.
  enabled         Boolean          @default(true)
  // Set the moment an admin edits this step's global content via the content
  // editor. Once set, a reseed excludes title/content/stepType from this
  // step's update payload (title/content stay whatever the admin set) —
  // mirrors how `enabled` is already permanently excluded from reseed today.
  contentEditedAt DateTime?        @map("content_edited_at")
  source          LessonStepSource @default(SEED) @map("source")

  lesson             Lesson                      @relation(fields: [lessonId], references: [id])
  classVisibility    ClassLessonStepVisibility[]
  // Teacher modules that were added relative to this step (ADR 0023). The FK
  // is SetNull, so deleting this step orphans the anchor but never deletes a
  // teacher's own content.
  anchoredClassSteps ClassLessonStep[]           @relation("ClassStepAnchor")

  @@map("lesson_steps")
}

// Per-class override for a BUILT-IN lesson step, on two independent axes:
//   - visibility: null = inherit the step's global `enabled` flag;
//     true/false forces show/hide (ADR 0015 behavior; since ADR 0023 the
//     per-class axis accepts ANY step type, while the GLOBAL `enabled`
//     kill-switch is still media-only).
//   - content: overrideTitle/overrideContent null = inherit the step's
//     global title/content; non-null = this class sees the override instead
//     (ADR 0023). The two axes are independent: a step can be globally
//     enabled but hidden for class A while also carrying a content override
//     that only matters for class B.
// A row with all three overrides null is meaningless and is pruned (see
// pruneOrUpdateOverrideRow in src/lib/lesson-media/index.ts). Cascade: an
// override is meaningless once its step is deleted.
//
// NOTE the name is narrower than the contract — this table carries visibility
// AND content. Deliberately not renamed: a @@map rename touches every call
// site for zero user-visible benefit. This comment is the contract.
// ORDER is deliberately NOT here: a pure reorder would create rows carrying no
// visibility or content opinion, and pruneOrUpdateOverrideRow would then
// delete a teacher's arrangement the moment they reset a content override.
// Order lives in ClassLessonOutline.
model ClassLessonStepVisibility {
  id              String   @id @default(cuid())
  classId         String   @map("class_id")
  lessonStepId    String   @map("lesson_step_id")
  visible         Boolean?
  overrideTitle   String?  @map("override_title")
  overrideContent String?  @map("override_content")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  class      Class      @relation(fields: [classId], references: [id])
  lessonStep LessonStep @relation(fields: [lessonStepId], references: [id], onDelete: Cascade)

  @@unique([classId, lessonStepId])
  @@map("class_lesson_step_visibility")
}

// Where a class-added module sits relative to its anchor. AFTER is the default
// (the "add a module here" gesture between two steps); BEFORE lets a teacher
// put their own opener ahead of the lesson's first built-in step.
enum ClassStepAnchor {
  BEFORE
  AFTER
}

// A lesson module a TEACHER authored for ONE of their classes (ADR 0023).
//
// Deliberately NOT a LessonStep row with a nullable classId: `lesson.steps` is
// read unfiltered by the student mission page, three teacher pages, the admin
// page and the seeder, so a nullable discriminator means one forgotten `where`
// leaks Period 3's module into Period 5's mission. Keeping teacher content in
// its own table also means the seeder's delete-dropped-steps pass can never
// reach it, and no global surface has to learn it exists.
//
// `content` holds the same string LessonStep.content holds (JSON for
// structured types, plain text for NOTE/VOCABULARY/DISCUSSION) and is
// validated by the SAME validateAndSerializeStepContent — a class module can
// never carry a shape the student renderer would reject.
model ClassLessonStep {
  id             String         @id @default(cuid())
  classId        String         @map("class_id")
  lessonId       String         @map("lesson_id")
  // Shared by the sibling rows created by ONE "add to all 5 classes" action,
  // so "edit/delete this everywhere" is a lookup rather than a heuristic.
  siblingGroupId String         @map("sibling_group_id")
  stepType       LessonStepType @map("step_type")
  title          String
  content        String
  // Always false. A teacher module must never gate progression (see
  // stepNeedsAttempt in src/lib/lesson-content/gating.ts) and can never be a
  // resume pointer.
  required       Boolean        @default(false)
  // The class's own hide switch for its own module — NOT routed through
  // ClassLessonStepVisibility, whose FK targets LessonStep and whose
  // "delete the row when every axis is null" invariant would need a nullable
  // second FK and a fourth axis to accommodate this.
  visible        Boolean        @default(true)

  // RECONSTRUCTION METADATA ONLY — position is authoritative in
  // ClassLessonOutline. Consulted when this module is absent from the saved
  // order (added on another device, or the outline was never written because
  // the teacher never reordered). SetNull, not Cascade: the seeder's
  // delete-dropped-steps pass must never take a teacher's module with it.
  anchorLessonStepId String?         @map("anchor_lesson_step_id")
  anchorPosition     ClassStepAnchor @default(AFTER) @map("anchor_position")

  // Scalar, no relation — same convention as UploadedLessonImage.uploadedBy.
  // Attribution only; assertClassOwnedByTeacher is what authorizes writes.
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  class      Class       @relation(fields: [classId], references: [id])
  lesson     Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  anchorStep LessonStep? @relation("ClassStepAnchor", fields: [anchorLessonStepId], references: [id], onDelete: SetNull)

  // The read path is always "every module for this class + lesson", ordered by
  // createdAt for the deterministic reconciliation tie-break.
  @@index([classId, lessonId, createdAt])
  @@index([siblingGroupId])
  @@map("class_lesson_steps")
}

// ONE row per (class, lesson) holding that class's effective module order as
// an ordered array mixing built-in LessonStep ids and ClassLessonStep ids
// (ADR 0023).
//
// AN ABSENT ROW MEANS the class has expressed no ordering opinion and sees the
// pristine built-in sequence. That is what makes "behaviour is identical for a
// class that never reordered" a structural property rather than a code path.
//
// Json rather than String[]: this schema uses no scalar lists anywhere, the
// array is always read and written whole, and it is never queried
// element-wise. It carries no referential integrity, so every read runs
// through reconcileClassOutline (src/lib/lesson-content/class-outline.ts).
model ClassLessonOutline {
  id             String   @id @default(cuid())
  classId        String   @map("class_id")
  lessonId       String   @map("lesson_id")
  orderedItemIds Json     @default("[]") @map("ordered_item_ids")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  class  Class  @relation(fields: [classId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([classId, lessonId])
  @@map("class_lesson_outlines")
}

// Binary storage for teacher/admin-uploaded lesson images (Postgres, not
// local disk — this app is documented as stateless/horizontally-scalable
// behind a load balancer; a filesystem write would only be visible from
// whichever instance received the upload). Served by
// src/app/media/uploads/[id]/route.ts at the public path
// `/media/uploads/<id>` — a cuid is lowercase alphanumeric, so it already
// matches ImageSchema.asset's `/media/...` pattern with no schema changes.
// Rows are immutable once created (content-addressed by id) — safe to cache
// the served response forever.
model UploadedLessonImage {
  id         String   @id @default(cuid())
  mimeType   String   @map("mime_type")
  byteSize   Int      @map("byte_size")
  // Nullable: the hand-rolled dimension parser (src/lib/media-upload/format.ts)
  // is best-effort for some formats (e.g. lossless WebP) and returns null on
  // a parse miss rather than failing the upload — the uploader just types
  // width/height in manually on the subsequent content-edit call.
  width      Int?
  height     Int?
  data       Bytes
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("uploaded_lesson_images")
}

// ============================================================
// STIMULI
// ============================================================

model Stimulus {
  id               String         @id @default(cuid())
  title            String
  stimulusType     StimulusType   @map("stimulus_type")
  content          String
  mediaUrl         String?        @map("media_url")
  source           String?
  copyrightNotes   String?        @map("copyright_notes")
  readingLoadLevel Int            @map("reading_load_level")
  approvalStatus   ApprovalStatus @default(DRAFT) @map("approval_status")

  variants  StimulusVariant[]
  questions Question[]

  @@map("stimuli")
}

model StimulusVariant {
  id               String         @id @default(cuid())
  stimulusId       String         @map("stimulus_id")
  readingLoadLevel Int            @map("reading_load_level")
  content          String
  approvalStatus   ApprovalStatus @default(DRAFT) @map("approval_status")

  stimulus Stimulus @relation(fields: [stimulusId], references: [id])

  @@unique([stimulusId, readingLoadLevel])
  @@map("stimulus_variants")
}

// ============================================================
// QUESTIONS & OPTIONS
// ============================================================

model Question {
  id                  String              @id @default(cuid())
  /// Stable external key for idempotent seed imports. Format: q-{benchmarkCode}-{NNN}
  externalKey         String?             @unique @map("external_key")
  benchmarkId         String              @map("benchmark_id")
  reportingCategoryId String              @map("reporting_category_id")
  prompt              String
  stimulusId          String?             @map("stimulus_id")
  itemType            ItemType            @map("item_type")
  difficulty          Float               @default(0.5)
  cognitiveComplexity CognitiveComplexity @map("cognitive_complexity")
  readingLoadLevel    Int                 @map("reading_load_level")
  skillTag            String              @map("skill_tag")
  remediationTag      String              @map("remediation_tag")
  misconceptionId     String?             @map("misconception_id")
  approvalStatus      ApprovalStatus      @default(APPROVED) @map("approval_status")
  sourceTier          SourceTier          @default(B) @map("source_tier")
  active              Boolean             @default(true)

  benchmark         Benchmark            @relation(fields: [benchmarkId], references: [id])
  reportingCategory ReportingCategory    @relation(fields: [reportingCategoryId], references: [id])
  stimulus          Stimulus?            @relation(fields: [stimulusId], references: [id])
  misconception     Misconception?       @relation("QuestionMisconception", fields: [misconceptionId], references: [id])
  options           QuestionOption[]
  assessmentItems   AssessmentQuestion[]

  @@index([benchmarkId])
  @@map("questions")
}

model QuestionOption {
  id              String  @id @default(cuid())
  questionId      String  @map("question_id")
  optionText      String  @map("option_text")
  /// SECURITY: Never expose isCorrect to the client before submission of a secure assessment.
  isCorrect       Boolean @map("is_correct")
  feedback        String?
  misconceptionId String? @map("misconception_id")

  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  misconception Misconception? @relation("OptionMisconception", fields: [misconceptionId], references: [id])

  @@map("question_options")
}

// ============================================================
// MISCONCEPTIONS
// ============================================================

model Misconception {
  id                      String         @id @default(cuid())
  code                    String         @unique
  reportingCategoryId     String         @map("reporting_category_id")
  label                   String
  description             String
  commonDistractorPattern String?        @map("common_distractor_pattern")
  /// Optional: points to a RemediationItem specifically designed to fix this misconception.
  fixRemediationId        String?        @map("fix_remediation_id")
  approvalStatus          ApprovalStatus @default(APPROVED) @map("approval_status")

  reportingCategory ReportingCategory @relation(fields: [reportingCategoryId], references: [id])
  fixRemediation    RemediationItem?  @relation("MisconceptionFix", fields: [fixRemediationId], references: [id])
  questions         Question[]        @relation("QuestionMisconception")
  questionOptions   QuestionOption[]  @relation("OptionMisconception")
  remediationItems  RemediationItem[] @relation("RemediationMisconception")

  @@map("misconceptions")
}

// ============================================================
// ASSESSMENTS
// ============================================================

model Assessment {
  id               String         @id @default(cuid())
  /// Nullable for Republic Challenge / Final Trial assessments which span benchmarks (Phase 11).
  /// All other AssessmentTypes require benchmarkId — enforced in code.
  benchmarkId      String?        @map("benchmark_id")
  title            String
  assessmentType   AssessmentType @map("assessment_type")
  masteryThreshold Float          @default(0.80) @map("mastery_threshold")
  blueprintJson    Json?          @map("blueprint_json")
  approvalStatus   ApprovalStatus @default(DRAFT) @map("approval_status")

  benchmark Benchmark?           @relation(fields: [benchmarkId], references: [id])
  questions AssessmentQuestion[]

  @@map("assessments")
}

model AssessmentQuestion {
  id            String @id @default(cuid())
  assessmentId  String @map("assessment_id")
  questionId    String @map("question_id")
  sequenceOrder Int    @map("sequence_order")
  points        Float  @default(1.0)

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  question   Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

// ============================================================
// REMEDIATION
// ============================================================

model RemediationItem {
  id              String          @id @default(cuid())
  benchmarkId     String          @map("benchmark_id")
  title           String
  remediationType RemediationType @map("remediation_type")
  skillTag        String          @map("skill_tag")
  misconceptionId String?         @map("misconception_id")
  content         String
  approvalStatus  ApprovalStatus  @default(DRAFT) @map("approval_status")

  benchmark           Benchmark       @relation(fields: [benchmarkId], references: [id])
  misconception       Misconception?  @relation("RemediationMisconception", fields: [misconceptionId], references: [id])
  fixForMisconception Misconception[] @relation("MisconceptionFix")

  @@map("remediation_items")
}

// ============================================================
// BADGES
// ============================================================

model Badge {
  id           String     @id @default(cuid())
  name         String     @unique
  description  String
  iconKey      String     @map("icon_key")
  criteriaJson Json       @map("criteria_json")
  track        BadgeTrack

  @@map("badges")
}

// ============================================================
// TEACHER OVERRIDES & AUDIT LOG
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}
