  student     Student     @relation(fields: [studentId], references: [id])
  benchmark   Benchmark   @relation(fields: [benchmarkId], references: [id])
  currentStep LessonStep? @relation("CurrentLessonStep", fields: [currentStepId], references: [id])

  @@unique([studentId, benchmarkId])
  @@index([studentId, benchmarkId])
  @@map("student_progress")
}

/// Dashboard "pick up where you left off": one row per student, upserted on
/// every meaningful action across mission/drill/republic-challenge/strategy/
/// source-decoder/remediation surfaces. referenceId's meaning depends on
/// activityType (see src/lib/student-activity for the read-side resolver) —
/// deliberately untyped/no FK so one column covers every activity type.
model StudentLastActivity {
  id           String              @id @default(cuid())
  studentId    String              @unique @map("student_id")
  activityType StudentActivityType @map("activity_type")
  referenceId  String?             @map("reference_id")
  occurredAt   DateTime            @default(now()) @map("occurred_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("student_last_activity")
}

model AssessmentAttempt {
  id            String    @id @default(cuid())
  assessmentId  String    @map("assessment_id")
  studentId     String    @map("student_id")
  attemptNumber Int       @map("attempt_number")
  score         Float?
  passed        Boolean?
  startedAt     DateTime  @default(now()) @map("started_at")
  submittedAt   DateTime? @map("submitted_at")
  voided        Boolean   @default(false)

  assessment      Assessment              @relation(fields: [assessmentId], references: [id])
  student         Student                 @relation(fields: [studentId], references: [id])
  responses       AttemptResponse[]
  adaptiveState   AdaptiveSessionState?
  integrityEvents AttemptIntegrityEvent[]

  @@index([assessmentId, studentId])
  @@index([studentId, voided])
  /// Supports session-window progress attribution (activity-sessions report).
  @@index([studentId, submittedAt])
  @@map("assessment_attempts")
}

model AttemptResponse {
  id               String  @id @default(cuid())
  attemptId        String  @map("attempt_id")
  questionId       String  @map("question_id")
  responseJson     Json    @map("response_json")
  selectedOptionId String? @map("selected_option_id")
  /// Server-computed — never accepted from client payload.
  isCorrect        Boolean @map("is_correct")
  pointsAwarded    Float   @default(0) @map("points_awarded")
  /// 0 = "Not sure", 1 = "Pretty sure", 2 = "Very sure"; null if not captured.
  confidence       Int?
  timeSeconds      Int?    @map("time_seconds")

  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id])
  question       Question          @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption?   @relation(fields: [selectedOptionId], references: [id])

  @@map("attempt_responses")
}

// ============================================================
// ASSESSMENT INTEGRITY
// Records that a student left a secure assessment (tab switch, window blur,
// fullscreen exit) or attempted a blocked input (copy/paste/print/right-click).
// See docs/adrs/0020-assessment-integrity-and-device-lockdown.md.
//
// A web app CANNOT lock down a Chromebook — that belongs to the device
// management layer (see docs/chromebook-lockdown.md). These rows are the app's
// honest fallback: they make leaving VISIBLE to the teacher without ever
// auto-punishing the student. Nothing here feeds grading, mastery, SM-2, or
// analytics; a teacher reviews the flag and decides (the existing void control
// on the student profile is the remedy).
//
// `recordedAt` is the SERVER clock only — the client never supplies a
// timestamp. `durationMs` is client-reported (it is the only party that can
// observe how long the tab was hidden) and is therefore advisory, never
// authoritative. Accommodation-sanctioned breaks generate no rows at all.
// ============================================================

model AttemptIntegrityEvent {
  id        String @id @default(cuid())
  attemptId String @map("attempt_id")
  /// BLUR | VISIBILITY_HIDDEN | FULLSCREEN_EXIT | COPY_BLOCKED
  /// | CUT_BLOCKED | PASTE_BLOCKED | CONTEXT_MENU_BLOCKED | PRINT_BLOCKED
  eventType String @map("event_type")
  /// Client-reported time away in ms; null for instantaneous events.
  durationMs Int?     @map("duration_ms")
  recordedAt DateTime @default(now()) @map("recorded_at")

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@map("attempt_integrity_events")
}

// ============================================================
// ADAPTIVE DIFFICULTY (Phase 6)
// Tracks within-session complexity state for PRACTICE sessions.
// Never created for MASTERY_CHALLENGE attempts (fixed-form rule).
// ============================================================

model AdaptiveSessionState {
  id                      String              @id @default(cuid())
  attemptId               String              @unique @map("attempt_id")
  /// Current target complexity level for next item selection.
  currentComplexity       CognitiveComplexity @default(LOW) @map("current_complexity")
  /// Consecutive correct answers at current complexity (resets on wrong or bump).
  consecutiveCorrect      Int                 @default(0) @map("consecutive_correct")
  /// Consecutive incorrect answers at current complexity (resets on correct or bump).
  consecutiveIncorrect    Int                 @default(0) @map("consecutive_incorrect")
  /// Next item to deliver is a worked example (triggered at 3 consecutive incorrect).
  pendingWorkedExample    Boolean             @default(false) @map("pending_worked_example")
  /// Next item is a near-transfer question (delivered after worked example).
  pendingNearTransfer     Boolean             @default(false) @map("pending_near_transfer")
  /// The question that triggered the worked example — used to show solution.
  workedExampleQuestionId String?             @map("worked_example_question_id")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])

  @@map("adaptive_session_states")
}

